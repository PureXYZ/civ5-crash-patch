// Version information shown in the DLL's Properties > Details tab.
#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     CIVFIX_VERSION_NUM
PRODUCTVERSION  CIVFIX_VERSION_NUM
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Civ V Crash Patch (loads into Civilization V; forwards msimg32.dll)"
            VALUE "FileVersion", CIVFIX_VERSION_STR
            VALUE "InternalName", "civprobe"
            VALUE "LegalCopyright", "MIT License, see LICENSE"
            VALUE "OriginalFilename", "msimg32.dll"
            VALUE "ProductName", "Civ V Crash Patch"
            VALUE "ProductVersion", CIVFIX_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
